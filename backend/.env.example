# PersonaRAG — Research Assistant for Students
# OpenAI is the only provider. Grab a key at https://platform.openai.com/api-keys

OPENAI_API_KEY=sk-proj-...

# Core models (defaults are production-sane)
OPENAI_CHAT_MODEL=gpt-4.1
OPENAI_UTILITY_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_MODERATION_MODEL=omni-moderation-latest

# Retrieval
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
HYBRID_BM25_WEIGHT=0.4
HYBRID_VECTOR_WEIGHT=0.6
RERANK_TOP_N=5
SEMANTIC_CACHE_THRESHOLD=0.95
QUERY_VARIATIONS=3

# Chunking
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Safety
ENABLE_MODERATION=true

# Observability (optional — leave blank to disable)
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=
LANGCHAIN_PROJECT=personarag

# Storage
DATABASE_URL=sqlite:///./db/personarag.db
APP_ENV=development
